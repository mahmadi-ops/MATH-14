<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - Review Problems #4, practice version: the same problems  -->
<!-- as review4-online.ptx, but with every <solution> removed and every  -->
<!-- <feedback> reduced to a neutral right/wrong message, so students     -->
<!-- can check their answers without seeing anything about the solutions. -->
<!-- This file is GENERATED-STYLE but maintained by hand: if the problems -->
<!-- in review4-online.ptx change, regenerate or mirror the change here. -->
<section xml:id="sec-exercises-review4-practice" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Review Problems #4<mdash/>Practice</title>

  <introduction>
    <p>
      Sections: <xref ref="section-greens-theorem" text="title"/>,
      <xref ref="section-surface-integrals" text="title"/>, and
      <xref ref="section-divergence-theorem" text="title"/>. Work each
      problem, then type your answers into the boxes and have them checked
      here.
    </p>
    <p>
      Every answer box is graded separately, so a box you fill in correctly
      earns its credit even if another box in the same problem is wrong.
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      This chapter is for testing yourself, so it contains the questions
      only. Checking an answer tells you whether it is right or wrong and
      nothing more<mdash/>no hints, no worked feedback, and no solutions.
      The same problems, with complete solutions, are in
      <xref ref="ch-review-solutions" text="title"/>.
    </p>
    <p>
      <term>How to type your answers.</term>
    </p>
    <ul>
      <li>
        <p>
          <term>Numbers.</term> Type a decimal number and nothing
          else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>. Give at
          least three decimal places (for instance <c>18.850</c>, not
          <c>6pi</c>). Answers are accepted within a small tolerance, so a
          little rounding is fine.
        </p>
      </li>
      <li>
        <p>
          <term>Expressions.</term> Type only the expression itself. Write
          products with <c>*</c> and powers with <c>^</c>, and write
          functions with parentheses: <c>cos(u)</c>, <c>sqrt(x^2+y^2)</c>,
          <c>e^z</c>. So the expression <m>2x + e^z</m> is typed
          <c>2*x + e^z</c>. Spaces are ignored.
        </p>
      </li>
      <li>
        <p>
          <term>Words.</term> Type just the word or letters asked for, in
          lower case unless the problem says otherwise.
        </p>
      </li>
    </ul>
  </introduction>

  <exercises xml:id="exercises-review4-practice">

  <!-- =================================================================== -->
  <!-- 1.  Divergence theorem on a box  (Edfinity/RP4 #1)                   -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-box-flux">
    <title>Outward Flux Through the Surface of a Box</title>
    <setup>
      <de-object name="A" context="number">
        <de-random distribution="discrete" min="2" max="9" by="1"/>
      </de-object>
      <de-object name="p" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="q" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="s" context="number">
        <de-random distribution="discrete" min="1" max="3" by="1"/>
      </de-object>
      <de-object name="zero" context="number">
        <de-expression>0</de-expression>
      </de-object>
      <de-object name="divF" context="formula">
        <de-expression>2*A*x+e^z</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>A*p^2*q*s+p*q*(e^s-1)</de-expression>
      </de-object>
      <de-object name="sumF" context="formula">
        <de-expression>A*x^2+z^4+e^z</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Evaluate the <alert>outward</alert> flux of the vector field
      </p>
      <me>
        \mathbf{F} = <eval obj="A"/>x^2\,\mathbf{i}
        + z^4\,\mathbf{j} + e^z\,\mathbf{k}
      </me>
      <p>
        through the surface <m>S</m> of the solid box <m>W</m> given by
        <m>0 \le x \le <eval obj="p"/></m>,
        <m>0 \le y \le <eval obj="q"/></m>,
        <m>0 \le z \le <eval obj="s"/></m>.
      </p>
      <p>
        <term>Part A.</term> By the Divergence Theorem the flux equals
        <m>\displaystyle\int_{a}^{b}\!\int_{c}^{d}\!\int_{e}^{f}</m>
        <fillin name="b1" mode="math" ansobj="divF" width="14"/>
        <m>\,dx\,dy\,dz</m>, where
      </p>
      <p>
        <m>a =</m> <fillin name="b2" mode="number" ansobj="zero" width="4"/>,
        <m>b =</m> <fillin name="b3" mode="number" ansobj="s" width="4"/>,
        <m>c =</m> <fillin name="b4" mode="number" ansobj="zero" width="4"/>,
        <m>d =</m> <fillin name="b5" mode="number" ansobj="q" width="4"/>,
        <m>e =</m> <fillin name="b6" mode="number" ansobj="zero" width="4"/>, and
        <m>f =</m> <fillin name="b7" mode="number" ansobj="p" width="4"/>.
      </p>
      <p>
        <term>Part B.</term> Evaluate the integral that you set up in the
        previous part.
      </p>
      <p>
        Flux <m>=</m> <fillin name="b8" mode="number" ansobj="flux" width="12"/>.
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <mathcmp obj="sumF"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="zero.value({})-Math.max(0.01,1e-4*Math.abs(zero.value({})))" max="zero.value({})+Math.max(0.01,1e-4*Math.abs(zero.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="s.value({})-Math.max(0.01,1e-4*Math.abs(s.value({})))" max="s.value({})+Math.max(0.01,1e-4*Math.abs(s.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="zero.value({})-Math.max(0.01,1e-4*Math.abs(zero.value({})))" max="zero.value({})+Math.max(0.01,1e-4*Math.abs(zero.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="q.value({})-Math.max(0.01,1e-4*Math.abs(q.value({})))" max="q.value({})+Math.max(0.01,1e-4*Math.abs(q.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="zero.value({})-Math.max(0.01,1e-4*Math.abs(zero.value({})))" max="zero.value({})+Math.max(0.01,1e-4*Math.abs(zero.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="p.value({})-Math.max(0.01,1e-4*Math.abs(p.value({})))" max="p.value({})+Math.max(0.01,1e-4*Math.abs(p.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 2.  Maximizing box flux from a given divergence  (RP4 #2)            -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-box-div-max">
    <title>The Box With the Largest Flux</title>
    <setup>
      <de-object name="A" context="number">
        <de-random distribution="discrete" min="2" max="8" by="1"/>
      </de-object>
      <de-object name="k" context="number">
        <de-random distribution="discrete" min="1" max="3" by="1"/>
      </de-object>
      <de-object name="twok" context="number">
        <de-expression>2*k</de-expression>
      </de-object>
      <de-object name="M" context="number">
        <de-random distribution="discrete" min="10" max="15" by="1"/>
      </de-object>
      <de-object name="fluxformula" context="formula">
        <de-expression>k*(2*A*a-a^2)*b*c</de-expression>
      </de-object>
      <de-object name="maxflux" context="number">
        <de-expression>k*A^2*M^2</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Let <m>\nabla \cdot \mathbf{F}
        = <eval obj="twok"/>\left(<eval obj="A"/> - x\right)</m> and
        <m>0 \le a, b, c \le <eval obj="M"/></m>.
      </p>
      <p>
        (a) Find the flux of <m>\mathbf{F}</m> out of the rectangular solid
        <m>0 \le x \le a</m>, <m>0 \le y \le b</m>, <m>0 \le z \le c</m>,
        as an expression in <m>a</m>, <m>b</m> and <m>c</m>.
      </p>
      <p>
        flux <m>=</m> <fillin name="b1" mode="math" ansobj="fluxformula" width="20"/>
      </p>
      <p>
        (b) For what values of <m>a</m>, <m>b</m>, <m>c</m> is the flux
        largest?
      </p>
      <p>
        <m>a =</m> <fillin name="b2" mode="number" ansobj="A" width="6"/>,
        <m>b =</m> <fillin name="b3" mode="number" ansobj="M" width="6"/>,
        <m>c =</m> <fillin name="b4" mode="number" ansobj="M" width="6"/>
      </p>
      <p>
        (c) What is that largest flux?
      </p>
      <p>
        flux <m>=</m> <fillin name="b5" mode="number" ansobj="maxflux" width="10"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="A.value({})-Math.max(0.01,1e-4*Math.abs(A.value({})))" max="A.value({})+Math.max(0.01,1e-4*Math.abs(A.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp object="M" min="M.value({})-Math.max(0.01,1e-4*Math.abs(M.value({})))" max="M.value({})+Math.max(0.01,1e-4*Math.abs(M.value({})))"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="M.value({})-Math.max(0.01,1e-4*Math.abs(M.value({})))" max="M.value({})+Math.max(0.01,1e-4*Math.abs(M.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="M.value({})-Math.max(0.01,1e-4*Math.abs(M.value({})))" max="M.value({})+Math.max(0.01,1e-4*Math.abs(M.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="maxflux.value({})-Math.max(0.01,1e-4*Math.abs(maxflux.value({})))" max="maxflux.value({})+Math.max(0.01,1e-4*Math.abs(maxflux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 3.  Verify the Divergence Theorem on a cylinder  (RP4 #3)            -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-verify-cylinder">
    <title>Verifying the Divergence Theorem on a Cylinder</title>
    <setup>
      <de-object name="A" context="number">
        <de-random distribution="discrete" min="2" max="9" by="1"/>
      </de-object>
      <de-object name="B" context="number">
        <de-random distribution="discrete" min="2" max="9" by="1"/>
      </de-object>
      <de-object name="C" context="number">
        <de-random distribution="discrete" min="2" max="9" by="1"/>
      </de-object>
      <de-object name="h" context="number">
        <de-random distribution="discrete" min="2" max="9" by="1"/>
      </de-object>
      <de-object name="both" context="number">
        <de-expression>A*h*pi</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Verify the Divergence Theorem for the vector field and region:
      </p>
      <me>
        \mathbf{F} = \langle <eval obj="A"/>x,\ <eval obj="B"/>z,\
        <eval obj="C"/>y \rangle
      </me>
      <p>
        and the region <m>x^2 + y^2 \le 1</m>,
        <m>0 \le z \le <eval obj="h"/></m>. Give each side as a decimal
        number.
      </p>
      <p>
        <m>\displaystyle\iint_{S} \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma =</m>
        <fillin name="b1" mode="number" ansobj="both" width="12"/>
      </p>
      <p>
        <m>\displaystyle\iiint_{W} \nabla \cdot \mathbf{F}\ dV =</m>
        <fillin name="b2" mode="number" ansobj="both" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="both.value({})-Math.max(0.01,1e-4*Math.abs(both.value({})))" max="both.value({})+Math.max(0.01,1e-4*Math.abs(both.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="both.value({})-Math.max(0.01,1e-4*Math.abs(both.value({})))" max="both.value({})+Math.max(0.01,1e-4*Math.abs(both.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 4.  Divergence theorem on a sphere  (RP4 #4)                         -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-sphere">
    <title>Flux Through a Sphere</title>
    <setup>
      <de-object name="R" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="Rsq" context="number">
        <de-expression>R^2</de-expression>
      </de-object>
      <de-object name="c" context="number">
        <de-random distribution="discrete" min="1" max="9" by="1"/>
      </de-object>
      <de-object name="divF" context="formula">
        <de-expression>3*x^2+3*z^2</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>8*pi*R^5/5</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Use the Divergence Theorem to evaluate the surface integral
        <m>\displaystyle\iint_{S} \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma</m>, where
      </p>
      <me>
        \mathbf{F} = \langle x^3,\ <eval obj="c"/>,\ z^3 \rangle
      </me>
      <p>
        and <m>S</m> is the sphere
        <m>x^2 + y^2 + z^2 = <eval obj="Rsq"/></m>, oriented outward.
      </p>
      <p>
        <m>\nabla \cdot \mathbf{F} =</m>
        <fillin name="b1" mode="math" ansobj="divF" width="14"/>
      </p>
      <p>
        <m>\displaystyle\iint_{S} \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma =</m>
        <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 5.  Flux through a paraboloid cap  (RP4 #5)                          -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-paraboloid-cap">
    <title>Flux Through a Paraboloid Cap</title>
    <setup>
      <de-object name="a" context="number">
        <de-random distribution="discrete" min="1" max="2" by="1"/>
      </de-object>
      <de-object name="u" context="number">
        <de-random distribution="discrete" min="0" max="1" by="1"/>
      </de-object>
      <de-object name="t" context="number">
        <de-random distribution="discrete" min="1" max="4" by="1"/>
      </de-object>
      <de-object name="b" context="number">
        <de-expression>(2*u-1)*t</de-expression>
      </de-object>
      <de-object name="h" context="number">
        <de-expression>1+a^2</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>b*(a^4/2+a^2)*pi</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Let
        <m>\mathbf{F}(x,y,z) = z\tan\!\left(y^2\right)\mathbf{i}
        + z^3\ln\!\left(x^2+1\right)\mathbf{j}
        + <eval obj="b"/>z\,\mathbf{k}</m>. Use the Divergence Theorem to
        find the flux of <m>\mathbf{F}</m> across the part of the
        paraboloid <m>x^2 + y^2 + z = <eval obj="h"/></m> that lies above
        the plane <m>z = 1</m> and is oriented upward.
      </p>
      <p>
        <m>\nabla \cdot \mathbf{F} =</m>
        <fillin name="b1" mode="number" ansobj="b" width="6"/>
        (a number)
      </p>
      <p>
        <m>\displaystyle\iint_{S} \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma =</m>
        <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="b.value({})-Math.max(0.01,1e-4*Math.abs(b.value({})))" max="b.value({})+Math.max(0.01,1e-4*Math.abs(b.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 6.  Radial field through a cylinder on the x-axis  (RP4 #6)          -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-cylinder-x-axis">
    <title>Radial Field Through a Closed Cylinder</title>
    <setup>
      <de-object name="R" context="number">
        <de-random distribution="discrete" min="2" max="6" by="1"/>
      </de-object>
      <de-object name="L" context="number">
        <de-random distribution="discrete" min="1" max="4" by="1"/>
      </de-object>
      <de-object name="three" context="number">
        <de-expression>3</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>6*pi*R^2*L</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Compute the flux of the vector field
        <m>\mathbf{F} = x\,\mathbf{i} + y\,\mathbf{j} + z\,\mathbf{k}</m>
        through the surface <m>S</m>, which is a closed cylinder of radius
        <m><eval obj="R"/></m> centered on the <m>x</m>-axis, with
        <m>-<eval obj="L"/> \le x \le <eval obj="L"/></m>, and oriented
        outward.
      </p>
      <p>
        <m>\nabla \cdot \mathbf{F} =</m>
        <fillin name="b1" mode="number" ansobj="three" width="6"/>
        (a number)
      </p>
      <p>
        Flux <m>=</m> <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="three.value({})-Math.max(0.01,1e-4*Math.abs(three.value({})))" max="three.value({})+Math.max(0.01,1e-4*Math.abs(three.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 7.  Constant field through a helicoid  (RP4 #7)                      -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-helicoid">
    <title>Flux Through a Helicoid</title>
    <setup>
      <de-object name="w" context="number">
        <de-random distribution="discrete" min="1" max="4" by="1"/>
      </de-object>
      <de-object name="c" context="number">
        <de-expression>w/2</de-expression>
      </de-object>
      <de-object name="integrand" context="formula">
        <de-expression>(w/2)*(sin(u)-cos(u)+v)</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>(w/2)*(2+pi/2)</de-expression>
      </de-object>
      <de-object name="wrongsign" context="formula">
        <de-expression>(w/2)*(cos(u)-sin(u)-v)</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Evaluate
        <m>\displaystyle\iint_S \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma</m>,
        where the vector field
        <m>\mathbf{F} = <eval obj="c"/>\,\mathbf{i}
        + <eval obj="c"/>\,\mathbf{j} + <eval obj="c"/>\,\mathbf{k}</m>
        and the parametrized surface <m>S</m> is the helicoid
      </p>
      <me>
        \mathbf{r}(u,v) = \left(v\cos u,\ v\sin u,\ u\right),
        \qquad 0 \le u \le \pi, \quad 0 \le v \le 1,
      </me>
      <p>
        oriented upward.
      </p>
      <p>
        First compute the integrand (as an expression in <m>u</m> and
        <m>v</m>):
        <m>\mathbf{F}\cdot\left(\mathbf{r}_v\times\mathbf{r}_u\right) =</m>
        <fillin name="b1" mode="math" ansobj="integrand" width="20"/>
      </p>
      <p>
        <m>\displaystyle\iint_S \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma =</m>
        <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <mathcmp obj="wrongsign"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 8.  Flux through a paraboloid over a disk  (RP4 #8)                  -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-paraboloid-updisk">
    <title>Flux Through a Paraboloid, Directly</title>
    <setup>
      <de-object name="a" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="R" context="number">
        <de-random distribution="discrete" min="2" max="6" by="1"/>
      </de-object>
      <de-object name="Rsq" context="number">
        <de-expression>R^2</de-expression>
      </de-object>
      <de-object name="integrand" context="formula">
        <de-expression>2*a*(x^2+y^2)</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>pi*a*R^4</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Compute the flux of the vector field
        <m>\mathbf{F} = <eval obj="a"/>x\,\mathbf{i}
        + <eval obj="a"/>y\,\mathbf{j}</m> through the surface <m>S</m>,
        which is the part of the surface
        <m>z = <eval obj="Rsq"/> - \left(x^2 + y^2\right)</m> above the
        disk of radius <m><eval obj="R"/></m> centered at the origin,
        oriented <alert>upward</alert>.
      </p>
      <p>
        Writing <m>z = f(x,y)</m>, we have
        <m>\hat{\mathbf{n}}\,d\sigma = \left(-f_x\,\mathbf{i} - f_y\,\mathbf{j}
        + \mathbf{k}\right)dx\,dy</m>, so (as an expression in <m>x</m>
        and <m>y</m>)
        <m>\mathbf{F}\cdot\left(-f_x\,\mathbf{i} - f_y\,\mathbf{j}
        + \mathbf{k}\right) =</m>
        <fillin name="b1" mode="math" ansobj="integrand" width="16"/>
      </p>
      <p>
        Flux <m>=</m> <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 9.  Green's theorem on a clockwise parallelogram  (RP4 #9)           -->
  <!-- =================================================================== -->
  <figure xml:id="fig-r4p-parallelogram">
    <caption>
      The parallelogram of <xref ref="ex-r4p-parallelogram"/>, with its
      orientation. Note the direction of the arrows.
    </caption>
    <image width="55%">
      <shortdescription>
      A parallelogram anchored at the origin with arrows showing its boundary orientation.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-r4p-parallelogram">
        <diagram dimensions="(360,240)" margins="10">
          <coordinates bbox="(-0.8,-0.55,4.9,2.3)">
            <axes at="pg-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <polygon at="pg-par" closed="yes" stroke="#CC0079" thickness="3"
                fill="#CC0079" fill-opacity="0.15"
                points="((0,0),(2,1.4),(4,1.4),(2,0))"/>
            <vector at="pg-e1" v="(0.7,0.49)" tail="(0.75,0.525)"
                stroke="#CC0079" thickness="3"/>
            <vector at="pg-e2" v="(0.8,0)" tail="(2.7,1.4)"
                stroke="#CC0079" thickness="3"/>
            <vector at="pg-e3" v="(-0.7,-0.49)" tail="(3.35,0.945)"
                stroke="#CC0079" thickness="3"/>
            <vector at="pg-e4" v="(-0.8,0)" tail="(1.3,0)"
                stroke="#CC0079" thickness="3"/>
            <point at="pg-O" p="(0,0)" fill="black" alignment="sw">
              <m>(0,0)</m>
            </point>
            <point at="pg-B" p="(2,0)" fill="black" alignment="se">
              <m>(x_0,0)</m>
            </point>
            <point at="pg-T1" p="(2,1.4)" fill="black" alignment="nw">
              <m>(x_0,y_0)</m>
            </point>
            <point at="pg-T2" p="(4,1.4)" fill="black" alignment="ne">
              <m>(2x_0,y_0)</m>
            </point>
          </coordinates>

          <annotations>
            <annotation ref="figure" text="A parallelogram with vertices at the origin, at x nought comma zero, at two x nought comma y nought, and at x nought comma y nought. Arrows on the edges show the boundary traversed clockwise: up the left edge from the origin, rightward across the top, down the right edge, and leftward along the bottom back to the origin.">
              <annotation ref="pg-par" text="The parallelogram with vertices at the origin, x nought comma zero, two x nought comma y nought, and x nought comma y nought."/>
              <annotation ref="pg-e1" text="An arrow on the left edge pointing up and to the right, from the origin toward x nought comma y nought."/>
              <annotation ref="pg-e2" text="An arrow on the top edge pointing to the right."/>
              <annotation ref="pg-e3" text="An arrow on the right edge pointing down and to the left, toward x nought comma zero."/>
              <annotation ref="pg-e4" text="An arrow on the bottom edge pointing to the left, back toward the origin. Altogether the circulation is clockwise."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-r4p-parallelogram">
    <title>Work Around a Parallelogram</title>
    <setup>
      <de-object name="n" context="number">
        <de-random distribution="discrete" min="2" max="6" by="1"/>
      </de-object>
      <de-object name="A" context="number">
        <de-random distribution="discrete" min="2" max="9" by="1"/>
      </de-object>
      <de-object name="x0" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="y0" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="curl" context="number">
        <de-expression>A</de-expression>
      </de-object>
      <de-object name="area" context="number">
        <de-expression>x0*y0</de-expression>
      </de-object>
      <de-object name="work" context="number">
        <de-expression>-A*x0*y0</de-expression>
      </de-object>
      <de-object name="poswork" context="number">
        <de-expression>A*x0*y0</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Use Green's Theorem to evaluate the work done by
        <m>\mathbf{F} = \langle x^{<eval obj="n"/>},\
        <eval obj="A"/>x \rangle</m> in moving an object around the
        boundary of the parallelogram in
        <xref ref="fig-r4p-parallelogram"/>
        (<alert>note the orientation</alert>), with
        <m>x_0 = <eval obj="x0"/></m> and <m>y_0 = <eval obj="y0"/></m>.
        Assume that the object circulates only once around the boundary
        and that its motion begins at the origin and ends at the same
        point.
      </p>
      <p>
        With <m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m>, first
        compute (a number):
        <m>\dfrac{\partial N}{\partial x}
        - \dfrac{\partial M}{\partial y} =</m>
        <fillin name="b1" mode="number" ansobj="curl" width="6"/>
      </p>
      <p>
        The area of the parallelogram is
        <fillin name="b2" mode="number" ansobj="area" width="6"/>.
      </p>
      <p>
        Work <m>=</m> <fillin name="b3" mode="number" ansobj="work" width="10"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="curl.value({})-Math.max(0.01,1e-4*Math.abs(curl.value({})))" max="curl.value({})+Math.max(0.01,1e-4*Math.abs(curl.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="area.value({})-Math.max(0.01,1e-4*Math.abs(area.value({})))" max="area.value({})+Math.max(0.01,1e-4*Math.abs(area.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="work.value({})-Math.max(0.01,1e-4*Math.abs(work.value({})))" max="work.value({})+Math.max(0.01,1e-4*Math.abs(work.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp object="poswork" min="poswork.value({})-Math.max(0.01,1e-4*Math.abs(poswork.value({})))" max="poswork.value({})+Math.max(0.01,1e-4*Math.abs(poswork.value({})))"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 10.  Three gradient fields and the unit circle  (RP4 #10)            -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-three-fields">
    <title>Three Gradient Fields and the Unit Circle</title>
    <setup>
      <de-object name="a1" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="a2" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="a3" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="fpot" context="formula">
        <de-expression>a1*x*y</de-expression>
      </de-object>
      <de-object name="hpot" context="formula">
        <de-expression>a3*sqrt(x^2+y^2)</de-expression>
      </de-object>
      <de-object name="zero" context="number">
        <de-expression>0</de-expression>
      </de-object>
      <de-object name="Gint" context="number">
        <de-expression>-2*pi*a2</de-expression>
      </de-object>
      <de-object name="posGint" context="number">
        <de-expression>2*pi*a2</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        (a) Each of the vector fields
      </p>
      <md>
        <mrow>
          \mathbf{F} \amp = <eval obj="a1"/>y\,\mathbf{i}
          + <eval obj="a1"/>x\,\mathbf{j},
        </mrow>
        <mrow>
          \mathbf{G} \amp = \frac{<eval obj="a2"/>y}{x^2+y^2}\,\mathbf{i}
          + \frac{-<eval obj="a2"/>x}{x^2+y^2}\,\mathbf{j},
        </mrow>
        <mrow>
          \mathbf{H} \amp = \frac{<eval obj="a3"/>x}{\sqrt{x^2+y^2}}
          \,\mathbf{i}
          + \frac{<eval obj="a3"/>y}{\sqrt{x^2+y^2}}\,\mathbf{j}
        </mrow>
      </md>
      <p>
        is a gradient vector field on some domain (not necessarily the
        whole plane). Find potential functions for <m>\mathbf{F}</m> and
        <m>\mathbf{H}</m>, choosing the constant so that the potential is
        <m>0</m> at the origin; and find the constant <m>C</m> for the
        potential of <m>\mathbf{G}</m>.
      </p>
      <p>
        For <m>\mathbf{F}</m>: <m>f(x,y) =</m>
        <fillin name="b1" mode="math" ansobj="fpot" width="16"/>
      </p>
      <p>
        For <m>\mathbf{G}</m>: <m>g(x,y)
        = C\arctan\!\left(\dfrac{x}{y}\right)</m> with <m>C =</m>
        <fillin name="b2" mode="number" ansobj="a2" width="6"/>
      </p>
      <p>
        For <m>\mathbf{H}</m>: <m>h(x,y) =</m>
        <fillin name="b3" mode="math" ansobj="hpot" width="16"/>
      </p>
      <p>
        (b) Find the line integrals of <m>\mathbf{F}</m>,
        <m>\mathbf{G}</m>, <m>\mathbf{H}</m> around the curve <m>C</m>
        given to be the unit circle in the <m>xy</m>-plane, centered at
        the origin, and traversed counterclockwise.
      </p>
      <p>
        <m>\displaystyle\int_C \mathbf{F}\cdot d\mathbf{r} =</m>
        <fillin name="b4" mode="number" ansobj="zero" width="8"/>,
        <m>\displaystyle\int_C \mathbf{G}\cdot d\mathbf{r} =</m>
        <fillin name="b5" mode="number" ansobj="Gint" width="8"/>,
        <m>\displaystyle\int_C \mathbf{H}\cdot d\mathbf{r} =</m>
        <fillin name="b6" mode="number" ansobj="zero" width="8"/>
      </p>
      <p>
        (c) For which of the three vector fields can Green's Theorem be
        used to calculate the line integral in part (b)? Type the letters
        of all that apply, with no spaces (for example <c>fg</c>):
        <fillin name="b7" mode="string" answer="f" width="6"/>
      </p>
      <p>
        <em>(Be sure that you are able to explain why or why not.)</em>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="a2.value({})-Math.max(0.01,1e-4*Math.abs(a2.value({})))" max="a2.value({})+Math.max(0.01,1e-4*Math.abs(a2.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="zero.value({})-Math.max(0.01,1e-4*Math.abs(zero.value({})))" max="zero.value({})+Math.max(0.01,1e-4*Math.abs(zero.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="Gint.value({})-Math.max(0.01,1e-4*Math.abs(Gint.value({})))" max="Gint.value({})+Math.max(0.01,1e-4*Math.abs(Gint.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp object="posGint" min="posGint.value({})-Math.max(0.01,1e-4*Math.abs(posGint.value({})))" max="posGint.value({})+Math.max(0.01,1e-4*Math.abs(posGint.value({})))"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="zero.value({})-Math.max(0.01,1e-4*Math.abs(zero.value({})))" max="zero.value({})+Math.max(0.01,1e-4*Math.abs(zero.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <strcmp case="insensitive">f</strcmp>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <strcmp case="insensitive">fgh</strcmp>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <strcmp strip="no">.*</strcmp>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 11.  Circulation around a rectangle  (RP4 #11)                       -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-rect-circulation">
    <title>Circulation Around a Rectangle</title>
    <setup>
      <de-object name="a" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="x0" context="number">
        <de-random distribution="discrete" min="2" max="8" by="1"/>
      </de-object>
      <de-object name="y0" context="number">
        <de-random distribution="discrete" min="1" max="6" by="1"/>
      </de-object>
      <de-object name="curlF" context="formula">
        <de-expression>-a*x</de-expression>
      </de-object>
      <de-object name="circ" context="number">
        <de-expression>-a*x0^2*y0/2</de-expression>
      </de-object>
      <de-object name="posax" context="formula">
        <de-expression>a*x</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Use Green's Theorem to calculate the circulation of
        <m>\mathbf{F} = <eval obj="a"/>xy\,\mathbf{i}</m> around the
        rectangle <m>0 \le x \le <eval obj="x0"/></m>,
        <m>0 \le y \le <eval obj="y0"/></m>, oriented counterclockwise.
      </p>
      <p>
        With <m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m>, first
        compute (as an expression in <m>x</m> and <m>y</m>):
        <m>\dfrac{\partial N}{\partial x}
        - \dfrac{\partial M}{\partial y} =</m>
        <fillin name="b1" mode="math" ansobj="curlF" width="10"/>
      </p>
      <p>
        circulation <m>=</m>
        <fillin name="b2" mode="number" ansobj="circ" width="10"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <mathcmp obj="posax"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="circ.value({})-Math.max(0.01,1e-4*Math.abs(circ.value({})))" max="circ.value({})+Math.max(0.01,1e-4*Math.abs(circ.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 12.  Circulation around a circle of radius m  (RP4 #12)              -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-circle-green">
    <title>Circulation Around a Circle</title>
    <setup>
      <de-object name="c1" context="number">
        <de-random distribution="discrete" min="2" max="8" by="1"/>
      </de-object>
      <de-object name="c2" context="number">
        <de-random distribution="discrete" min="2" max="8" by="1"/>
      </de-object>
      <de-object name="c4" context="number">
        <de-random distribution="discrete" min="2" max="8" by="1"/>
      </de-object>
      <de-object name="u" context="number">
        <de-random distribution="discrete" min="0" max="1" by="1"/>
      </de-object>
      <de-object name="d0" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="c3" context="number">
        <de-expression>c2+(2*u-1)*d0</de-expression>
      </de-object>
      <de-object name="m" context="number">
        <de-random distribution="discrete" min="2" max="6" by="1"/>
      </de-object>
      <de-object name="diff" context="number">
        <de-expression>(2*u-1)*d0</de-expression>
      </de-object>
      <de-object name="circ" context="number">
        <de-expression>(2*u-1)*d0*pi*m^2</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Calculate
        <m>\displaystyle\int_C \left(\left(<eval obj="c1"/>x
        + <eval obj="c2"/>y\right)\mathbf{i}
        + \left(<eval obj="c3"/>x + <eval obj="c4"/>y\right)\mathbf{j}
        \right)\cdot d\mathbf{r}</m>, where <m>C</m> is the circular path
        with center <m>(a,b)</m> and radius <m><eval obj="m"/></m>,
        oriented counterclockwise. Use Green's Theorem.
      </p>
      <p>
        With <m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m>, first
        compute (a number):
        <m>\dfrac{\partial N}{\partial x}
        - \dfrac{\partial M}{\partial y} =</m>
        <fillin name="b1" mode="number" ansobj="diff" width="6"/>
      </p>
      <p>
        <m>\displaystyle\int_C \mathbf{F}\cdot d\mathbf{r} =</m>
        <fillin name="b2" mode="number" ansobj="circ" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="diff.value({})-Math.max(0.01,1e-4*Math.abs(diff.value({})))" max="diff.value({})+Math.max(0.01,1e-4*Math.abs(diff.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="circ.value({})-Math.max(0.01,1e-4*Math.abs(circ.value({})))" max="circ.value({})+Math.max(0.01,1e-4*Math.abs(circ.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 13.  A family of radial fields r^A (x i + y j)  (RP4 #13)            -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-radial-power">
    <title>Divergence of a Family of Radial Fields</title>
    <setup>
      <de-object name="pp" context="number">
        <de-random distribution="discrete" min="1" max="8" by="1"/>
      </de-object>
      <de-object name="qq" context="number">
        <de-random distribution="discrete" min="1" max="6" by="1"/>
      </de-object>
      <de-object name="a1" context="number">
        <de-expression>-2+pp</de-expression>
      </de-object>
      <de-object name="a2" context="number">
        <de-expression>-2-qq</de-expression>
      </de-object>
      <de-object name="coeff" context="formula">
        <de-expression>2+A</de-expression>
      </de-object>
      <de-object name="expo" context="formula">
        <de-expression>A</de-expression>
      </de-object>
      <de-object name="minustwo" context="number">
        <de-expression>-2</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Let <m>r = \left(x^2+y^2\right)^{1/2}</m> and consider the vector
        field <m>\mathbf{F} = r^A\!\left(x\,\mathbf{i} +
        y\,\mathbf{j}\right)</m>, where <m>r \ne 0</m> and <m>A</m> is a
        constant. <m>\mathbf{F}</m> has no <m>z</m>-component and is
        independent of <m>z</m>.
      </p>
      <p>
        (a) Find <m>\nabla \cdot \left(r^A\!\left(x\,\mathbf{i}
        + y\,\mathbf{j}\right)\right)</m>, and show that it can be written
        in the form <m>\nabla \cdot \mathbf{F} = c\,r^{a}</m>. As
        expressions in <m>A</m>:
      </p>
      <p>
        <m>c =</m> <fillin name="b1" mode="math" ansobj="coeff" width="8"/>, and
        <m>a =</m> <fillin name="b2" mode="math" ansobj="expo" width="8"/>.
      </p>
      <p>
        (b) For what values of <m>A</m> is <m>\nabla \cdot \mathbf{F}</m>
        positive, negative, or zero?
      </p>
      <p>
        <m>\nabla \cdot \mathbf{F}</m> is positive for <m>A \gt</m>
        <fillin name="b3" mode="number" ansobj="minustwo" width="6"/>,
        negative for <m>A \lt</m>
        <fillin name="b4" mode="number" ansobj="minustwo" width="6"/>, and
        zero for <m>A =</m>
        <fillin name="b5" mode="number" ansobj="minustwo" width="6"/>.
      </p>
      <p>
        (c) Suppose that <m>A = <eval obj="a1"/></m>. What is the sign of
        the flux out of a small sphere centered at <m>(1,1,1)</m>? Type
        <c>positive</c> or <c>negative</c>:
        <fillin name="b6" mode="string" answer="positive" width="10"/>
      </p>
      <p>
        If instead <m>A = <eval obj="a2"/></m>, what is the sign of the
        flux out of a small sphere centered at <m>(1,1,1)</m>?
        <fillin name="b7" mode="string" answer="negative" width="10"/>
      </p>
      <p>
        <em>(Be sure you can say how your answers in part (c) would change
        if the question were about a small sphere centered at
        <m>(0,0,0)</m>.)</em>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="minustwo.value({})-Math.max(0.01,1e-4*Math.abs(minustwo.value({})))" max="minustwo.value({})+Math.max(0.01,1e-4*Math.abs(minustwo.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="minustwo.value({})-Math.max(0.01,1e-4*Math.abs(minustwo.value({})))" max="minustwo.value({})+Math.max(0.01,1e-4*Math.abs(minustwo.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="minustwo.value({})-Math.max(0.01,1e-4*Math.abs(minustwo.value({})))" max="minustwo.value({})+Math.max(0.01,1e-4*Math.abs(minustwo.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <strcmp case="insensitive">positive</strcmp>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <strcmp strip="no">.*</strcmp>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <strcmp case="insensitive">negative</strcmp>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <strcmp strip="no">.*</strcmp>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 14.  Cylinder between two slanted planes  (RP4 #14)                  -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-cylinder-band">
    <title>Flux Through a Slanted Cylinder Band</title>
    <setup>
      <de-object name="R" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="Rsq" context="number">
        <de-expression>R^2</de-expression>
      </de-object>
      <de-object name="z0" context="number">
        <de-random distribution="discrete" min="1" max="3" by="1"/>
      </de-object>
      <de-object name="dz" context="number">
        <de-random distribution="discrete" min="2" max="6" by="1"/>
      </de-object>
      <de-object name="z1" context="number">
        <de-expression>z0+dz</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>2*pi*R^2*dz</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Compute the flux of
        <m>\mathbf{F} = x\,\mathbf{i} + y\,\mathbf{j} + z\,\mathbf{k}</m>
        through the surface of the cylinder
        <m>x^2 + y^2 = <eval obj="Rsq"/></m> bounded below by the plane
        <m>x + y + z = <eval obj="z0"/></m>, above by the plane
        <m>x + y + z = <eval obj="z1"/></m>, and
        <alert>oriented away from the <m>z</m>-axis</alert>. Note that we
        are only interested in the flux through the curved surface of the
        cylinder.
      </p>
      <p>
        On the cylinder, <m>\mathbf{F}\cdot\hat{\mathbf{n}} =</m>
        <fillin name="b1" mode="number" ansobj="R" width="6"/>
        (a number).
      </p>
      <p>
        Flux <m>=</m> <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="R.value({})-Math.max(0.01,1e-4*Math.abs(R.value({})))" max="R.value({})+Math.max(0.01,1e-4*Math.abs(R.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 15.  Flux out of a closed cone  (RP4 #15)                            -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-cone">
    <title>Flux Out of a Closed Cone</title>
    <setup>
      <de-object name="a" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="B" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="C" context="number">
        <de-random distribution="discrete" min="2" max="5" by="1"/>
      </de-object>
      <de-object name="r" context="number">
        <de-random distribution="discrete" min="1" max="3" by="1"/>
      </de-object>
      <de-object name="divF" context="formula">
        <de-expression>2*a*y</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>a*r^4*pi/2</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Find the flux of
        <m>\mathbf{F} = <eval obj="B"/>z\,\mathbf{i}
        + <eval obj="a"/>y^2\,\mathbf{j} + <eval obj="C"/>x\,\mathbf{k}</m>
        out of the closed cone <m>y = \sqrt{x^2 + z^2}</m>, with
        <m>0 \le y \le <eval obj="r"/></m>.
      </p>
      <p>
        <m>\nabla \cdot \mathbf{F} =</m>
        <fillin name="b1" mode="math" ansobj="divF" width="10"/>
        (an expression in <m>x</m>, <m>y</m>, <m>z</m>)
      </p>
      <p>
        flux <m>=</m> <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  <!-- =================================================================== -->
  <!-- 16.  Divergence theorem on a tetrahedron  (RP4 #16)                  -->
  <!-- =================================================================== -->
  <exercise xml:id="ex-r4p-tetrahedron">
    <title>Flux Through the Surface of a Tetrahedron</title>
    <setup>
      <de-object name="a" context="number">
        <de-random distribution="discrete" min="2" max="4" by="1"/>
      </de-object>
      <de-object name="b" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="c" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="divF" context="formula">
        <de-expression>1+x</de-expression>
      </de-object>
      <de-object name="flux" context="number">
        <de-expression>a*b*c*(a+4)/24</de-expression>
      </de-object>
      <de-object name="vol" context="number">
        <de-expression>a*b*c/6</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Use the Divergence Theorem to calculate the flux of
        <m>\mathbf{F}</m> across <m>S</m>, where
        <m>\mathbf{F} = z\,\mathbf{i} + y\,\mathbf{j} +
        zx\,\mathbf{k}</m> and <m>S</m> is the surface of the tetrahedron
        enclosed by the coordinate planes and the plane
      </p>
      <me>
        \frac{x}{<eval obj="a"/>} + \frac{y}{<eval obj="b"/>}
        + \frac{z}{<eval obj="c"/>} = 1.
      </me>
      <p>
        <m>\nabla \cdot \mathbf{F} =</m>
        <fillin name="b1" mode="math" ansobj="divF" width="10"/>
        (an expression in <m>x</m>, <m>y</m>, <m>z</m>)
      </p>
      <p>
        <m>\displaystyle\iint_S \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma =</m>
        <fillin name="b2" mode="number" ansobj="flux" width="12"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <test correct="yes">
          <mathcmp use-answer="yes"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes" min="flux.value({})-Math.max(0.01,1e-4*Math.abs(flux.value({})))" max="flux.value({})+Math.max(0.01,1e-4*Math.abs(flux.value({})))"/>
          <feedback>
            <p>Correct.</p>
          </feedback>
        </test>
        <test>
          <numcmp object="vol" min="vol.value({})-Math.max(0.01,1e-4*Math.abs(vol.value({})))" max="vol.value({})+Math.max(0.01,1e-4*Math.abs(vol.value({})))"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
            <p>
              Not correct yet<mdash/>check your work and try again.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
  </exercise>

  </exercises>
</section>
