<!--   TikZ figures : embedded inline inside <image><latex-image> ...      -->
<!--                                                                       -->
<!-- REQUIREMENT: the TikZ figures need this in <docinfo> of the main      -->
<!-- file (see the note accompanying this file):                           -->
<!--   <latex-image-preamble>                                              -->
<!--     \usepackage{tikz}                                                 -->
<!--     \usetikzlibrary{arrows.meta}                                      -->
<!--     \usepackage{pgfplots}                                             -->
<!--     \pgfplotsset{compat=1.18}                                         -->
