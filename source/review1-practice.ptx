  <figure xml:id="fig-r1p-vf-hyperbolic">
    <caption>Graph <m>C</m>.</caption>
    <image width="100%">
      <shortdescription>Vector field C: arrows drawn at a grid of points, each with a dot at its tail.</shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-r1p-vf-hyperbolic">
        <diagram dimensions="(210,210)" margins="4">
          <coordinates bbox="(-2.3,-2.3,2.3,2.3)">
            <vector at="vf1" v="(0.240,-0.240)" tail="(-1.5,-1.5)" stroke="#3c6fbf" thickness="2"/>
            <point at="pt1" p="(-1.5,-1.5)" size="3" stroke="#8b1a2b" fill="none"/>
            <vector at="vf2" v="(0.283,-0.189)" tail="(-1.5,-1.0)" stroke="#3c6fbf" thickness="2"/>
            <point at="pt2" p="(-1.5,-1.0)" size="3" stroke="#8b1a2b" fill="none"/>
