<definition>blob(t) = ((1.5 + 0.55*sin(2*t) + 0.3*cos(3*t))*cos(t) + 0.2,
(1.2 + 0.45*cos(2*t) + 0.25*sin(3*t))*sin(t) + 0.4)</definition>
<coordinates bbox="(-2.9,-2.2,2.9,2.8)">
<axes at="sc-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<parametric-curve at="sc-region" function="blob" domain="(0,2*pi)"
    closed="yes" fill="#f4e3c1" stroke="#56B4E9" thickness="2"/>
