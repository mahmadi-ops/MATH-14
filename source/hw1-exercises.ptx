<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW1: Sections 13.1 Curves in Space and 13.3 Arc Length in Space -->
<exercises xml:id="exercises-hw1" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Homework 1</title>

  <introduction>
    <p>
      Sections: 13.1 Curves in Space and 13.3 Arc Length in Space.
    </p>
  </introduction>

  <exercise xml:id="ex-hw1-parametrize-intersection">
    <statement>
      <p>
        The curve <m>C</m> is the intersection of <m>x^2 + y^2 = 1</m>
        and <m>z = 4x^2</m>. Parametrize <m>C</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw1-helix">
    <introduction>
      <p>
        The curve <m>C</m> is a helix of radius <m>R</m> and height <m>H</m>.
        Moreover, let <m>N</m> denote the number of turns (revolutions) for
        the helix.
      </p>
      <figure xml:id="fig-hw1-springs">
        <caption>Which spring uses more wire?</caption>
        <image xml:id="img-hw1-springs" width="80%">
          <latex-image>
            <![CDATA[\begin{tikzpicture}[scale=0.32, line cap=round]
  %% Spring A: 3 turns, radius 7, height 4
  \begin{scope}
    % wire: outline pass then white core pass
    \draw[line width=3.2pt, black!55]
      plot[domain=90:1170, samples=700, smooth]
      ({7*sin(\x)}, {1.6*cos(\x) + 4*(\x-90)/1080});
    \draw[line width=1.8pt, white]
      plot[domain=90:1170, samples=700, smooth]
      ({7*sin(\x)}, {1.6*cos(\x) + 4*(\x-90)/1080});
    % height marker
    \draw[dashed, black!70] (0,1.6) -- (9.3,1.6);
    \draw[dashed, black!70] (0,5.6) -- (9.3,5.6);
    \draw[<->, black!70] (8.8,1.6) -- (8.8,5.6)
      node[midway, right, black] {\small $4$ cm};
    % caption labels
    \node[align=center] at (0,-4.2) {\small $3$ turns, radius $7$ cm};
    \node at (0,-5.8) {\small (A)};
  \end{scope}
  %% Spring B: 5 turns, radius 4, height 3
  \begin{scope}[xshift=21cm]
    \draw[line width=3.2pt, black!55]
      plot[domain=90:1890, samples=900, smooth]
      ({4*sin(\x)}, {1.0*cos(\x) + 3*(\x-90)/1800});
    \draw[line width=1.8pt, white]
      plot[domain=90:1890, samples=900, smooth]
      ({4*sin(\x)}, {1.0*cos(\x) + 3*(\x-90)/1800});
    \draw[dashed, black!70] (0,1.0) -- (6.3,1.0);
    \draw[dashed, black!70] (0,4.0) -- (6.3,4.0);
    \draw[<->, black!70] (5.8,1.0) -- (5.8,4.0)
      node[midway, right, black] {\small $3$ cm};
    \node[align=center] at (0,-4.2) {\small $5$ turns, radius $4$ cm};
    \node at (0,-5.8) {\small (B)};
  \end{scope}
\end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </introduction>
    <task>
      <statement>
        <p>Parametrize <m>C</m>.</p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Compute the length of the two springs shown in
          <xref ref="fig-hw1-springs"/>. Which spring uses more wire?
          A or B?
        </p>
      </statement>
    </task>
  </exercise>

  <exercise xml:id="ex-hw1-tangent-line">
    <statement>
      <p>
        Find equation of the tangent line to the curve
        <me>\vec{r}(t) = \left\langle \ln(t),\, \frac{t-1}{t+2},\, t\ln(t) \right\rangle</me>
        at the point <m>P(0,0,0)</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw1-location">
    <statement>
      <p>
        The path of an object is given by
        <me>\vec{r}(t) = \left\langle 12t,\, 8t^{3/2},\, 3t^2 \right\rangle.</me>
        Assume that the starting point of the object's motion is the origin.
        Determine the <term>location of the object</term> after traveling a
        distance of <m>15</m>.
      </p>
    </statement>
  </exercise>

</exercises>
