<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW4, online version: the same problems as the written       -->
<!-- Assignment 4, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw4-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 4</title>

  <introduction>
    <p>
      Sections: <xref ref="section-conservative-fields" text="title"/>, <xref ref="section-double-integrals-rectangles" text="title"/>, and <xref ref="section-double-integrals-general-regions" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Every answer box is graded separately, so a box you fill in correctly
      earns its credit even if another box in the same problem is wrong.
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw4-online">

  <figure xml:id="fig-hw4o-paths">
    <caption>
      The vector field <m>\mathbf{F}</m> and the two paths <m>ADC</m> and
      <m>ABC</m> of <xref ref="ex-hw4o-two-paths"/>. Every field vector
      points in the same direction; only their lengths change.
    </caption>
    <image width="70%">
      <shortdescription>
      A uniform slanted field with a square path from corner A to corner B.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw4o-paths">
        <diagram dimensions="(360,320)" margins="10">
          <definition>G(x,y) = (0.16*(1+x), 0.16*(1+x))</definition>
          <coordinates bbox="(-0.3,-0.3,3.3,3.0)">
            <axes at="hp-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <repeat at="hp-cols" parameter="i=0..6">
              <repeat parameter="j=0..5">
                <vector at="hp-v-((i))-((j))" v="G(0.45*i+0.12, 0.5*j+0.12)"
                    tail="(0.45*i+0.12, 0.5*j+0.12)" stroke="#56B4E9"
                    thickness="2"/>
              </repeat>
            </repeat>
            <polygon at="hp-square" closed="yes" stroke="#CC0079" thickness="3"
                fill="none" points="((0.8,0.7),(2.4,0.7),(2.4,2.3),(0.8,2.3))"/>
            <point at="hp-A" p="(0.8,0.7)" fill="black" alignment="sw">
              <m>A</m>
            </point>
            <point at="hp-D" p="(2.4,0.7)" fill="black" alignment="se">
              <m>D</m>
            </point>
            <point at="hp-C" p="(2.4,2.3)" fill="black" alignment="ne">
              <m>C</m>
            </point>
            <point at="hp-B" p="(0.8,2.3)" fill="black" alignment="nw">
              <m>B</m>
            </point>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="A grid of light blue field vectors, all pointing up and to the right at the same angle, with lengths that grow as x increases. A magenta square is drawn with corners A at the lower left, D at the lower right, C at the upper right and B at the upper left, so the path A D C runs along the bottom and up the right side, while A B C runs up the left side and along the top.">
              <annotation ref="hp-cols" text="The field vectors, all parallel and pointing up and to the right, growing longer toward the right of the picture."/>
              <annotation ref="hp-square" text="The square whose corners are A, B, C and D; the two paths of the problem run along its sides."/>
              <annotation ref="hp-A" text="The corner A, at the lower left."/>
              <annotation ref="hp-D" text="The corner D, at the lower right; the path A D C passes through it."/>
              <annotation ref="hp-C" text="The corner C, at the upper right."/>
              <annotation ref="hp-B" text="The corner B, at the upper left; the path A B C passes through it."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw4o-two-paths">
    <title>Which Path Takes Less Work?</title>
    <statement>
      <p>
        For the field of <xref ref="fig-hw4o-paths"/>: over which path does
        <m>\mathbf{F}</m> perform less work? Type <c>ADC</c> or
        <c>ABC</c>.
      </p>
      <p>Answer: <var width="8"/></p>
      <p>Is <m>\mathbf{F}</m> conservative? Type <c>yes</c> or <c>no</c>.</p>
      <p>Answer: <var width="8"/></p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="abc">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string="adc">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="no">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string="yes">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw4-solutions">
      <p>
        Both paths run along two sides of the square. The horizontal sides
        <m>AD</m> and <m>BC</m> contribute the same, but the vertical side
        <m>DC</m> sits where the field is longer than it is along
        <m>AB</m>, and the angle between <m>\mathbf{F}</m> and
        <m>\hat{\mathbf{T}}</m> is the same on both. Hence
        <m>\int_{ADC} \gt \int_{ABC}</m>, so <m>ABC</m> is the path of
        less work.
      </p>
      <p>
        Because the two paths share their endpoints and give different
        work, <m>\mathbf{F}</m> is <term>not</term> conservative: a
        conservative field is path-independent.
      </p>
    </solution>
  </exercise>

  <figure xml:id="fig-hw4o-shapes">
    <caption>
      The four shapes of <xref ref="ex-hw4o-density-shapes"/>. Shapes
      <m>1</m> and <m>2</m> are triangles cut off by <m>y=r</m> and
      <m>x=r</m>; shapes <m>3</m> and <m>4</m> are sectors of the circle
      <m>x^2+y^2=r^2</m>. The dashed lines are <m>y=x</m> and
      <m>y=-x</m>.
    </caption>
    <image width="85%">
      <shortdescription>
      Four small pictures of candidate regions, each on its own axes.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw4o-shapes">
        <diagram dimensions="(460,340)" margins="8">
          <definition>arc3(t) = (2.6 + 1.3*cos(t), 4.6 + 1.3*sin(t))</definition>
          <definition>arc4(t) = (7.4 + 1.3*cos(t), 4.6 + 1.3*sin(t))</definition>
          <coordinates bbox="(0.2,-0.9,9.9,7.6)">
            <!-- shape 1: above y = x, cut by y = r -->
            <polygon at="hs1" closed="yes" fill="#c9c9c9" stroke="#555555"
                thickness="2" points="((1.3,1.0),(2.6,2.3),(1.3,2.3))"/>
            <line at="hs1-x" endpoints="((0.5,1.0),(3.4,1.0))" stroke="black"
                thickness="1"/>
            <line at="hs1-y" endpoints="((1.3,0.2),(1.3,2.9))" stroke="black"
                thickness="1"/>
            <line at="hs1-diag" endpoints="((1.3,1.0),(3.0,2.7))"
                stroke="#777777" thickness="1" dash="4 3"/>
            <line at="hs1-cut" endpoints="((0.9,2.3),(2.9,2.3))"
                stroke="#777777" thickness="1" dash="4 3"/>
            <label at="hs1-lab" anchor="(1.75,1.75)" alignment="center">
              <m>1</m>
            </label>
            <label at="hs1-yr" anchor="(2.95,2.3)" alignment="e"
                color="#555555"><m>y=r</m></label>
            <label at="hs1-diaglab" anchor="(3.05,2.72)" alignment="ne"
                color="#555555"><m>y=x</m></label>
            <!-- shape 2: below y = x, cut by x = r -->
            <polygon at="hs2" closed="yes" fill="#c9c9c9" stroke="#555555"
                thickness="2" points="((6.1,1.0),(7.4,1.0),(7.4,2.3))"/>
            <line at="hs2-x" endpoints="((5.3,1.0),(8.2,1.0))" stroke="black"
                thickness="1"/>
            <line at="hs2-y" endpoints="((6.1,0.2),(6.1,2.9))" stroke="black"
                thickness="1"/>
            <line at="hs2-diag" endpoints="((6.1,1.0),(7.8,2.7))"
                stroke="#777777" thickness="1" dash="4 3"/>
            <line at="hs2-cut" endpoints="((7.4,0.5),(7.4,2.6))"
                stroke="#777777" thickness="1" dash="4 3"/>
            <label at="hs2-lab" anchor="(7.0,1.45)" alignment="center">
              <m>2</m>
            </label>
            <label at="hs2-xr" anchor="(7.45,0.45)" alignment="se"
                color="#555555"><m>x=r</m></label>
            <label at="hs2-diaglab" anchor="(7.85,2.72)" alignment="ne"
                color="#555555"><m>y=x</m></label>
            <!-- shape 3: the sector between y = x and the y-axis -->
            <polygon at="hs3" closed="yes" fill="#c9c9c9" stroke="none"
                points="((2.6,4.6),(3.52,5.52),(3.32,5.85),(3.06,6.09),(2.75,6.24),(2.6,5.9))"/>
            <parametric-curve at="hs3-arc" function="arc3" domain="(pi/4,pi/2)"
                stroke="#555555" thickness="2"/>
            <line at="hs3-x" endpoints="((1.8,4.6),(4.7,4.6))" stroke="black"
                thickness="1"/>
            <line at="hs3-y" endpoints="((2.6,3.8),(2.6,6.7))" stroke="black"
                thickness="1"/>
            <line at="hs3-diag" endpoints="((2.6,4.6),(4.3,6.3))"
                stroke="#777777" thickness="1" dash="4 3"/>
            <label at="hs3-lab" anchor="(2.98,5.42)" alignment="center">
              <m>3</m>
            </label>
            <label at="hs3-circ" anchor="(1.75,4.05)" alignment="e"
                color="#555555"><m>x^2+y^2=r^2</m></label>
            <label at="hs3-diaglab" anchor="(4.35,6.32)" alignment="ne"
                color="#555555"><m>y=x</m></label>
            <!-- shape 4: the sector between y = -x and the negative x-axis -->
            <polygon at="hs4" closed="yes" fill="#c9c9c9" stroke="none"
                points="((7.4,4.6),(6.1,4.6),(6.25,4.94),(6.48,5.22),(6.74,5.44),(7.4,4.6))"/>
            <parametric-curve at="hs4-arc" function="arc4"
                domain="(3*pi/4,pi)" stroke="#555555" thickness="2"/>
            <line at="hs4-x" endpoints="((5.6,4.6),(8.5,4.6))" stroke="black"
                thickness="1"/>
            <line at="hs4-y" endpoints="((7.4,3.8),(7.4,6.7))" stroke="black"
                thickness="1"/>
            <line at="hs4-diag" endpoints="((7.4,4.6),(5.9,6.1))"
                stroke="#777777" thickness="1" dash="4 3"/>
            <label at="hs4-lab" anchor="(6.72,4.92)" alignment="center">
              <m>4</m>
            </label>
            <label at="hs4-circ" anchor="(6.55,4.05)" alignment="e"
                color="#555555"><m>x^2+y^2=r^2</m></label>
            <label at="hs4-diaglab" anchor="(6.30,5.55)" alignment="sw"
                color="#555555"><m>y=-x</m></label>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="Four small pictures, each with its own pair of axes. Shape one is the triangle lying above the line y equals x and below the line y equals r. Shape two is the triangle lying below y equals x and to the left of the line x equals r. Shape three is the sector of the circle of radius r between the line y equals x and the positive y axis. Shape four is the sector of the same circle between the line y equals minus x and the negative x axis.">
              <annotation ref="hs1" text="Shape one, the triangle above the line y equals x, where the absolute value of y is at least the absolute value of x."/>
              <annotation ref="hs2" text="Shape two, the triangle below the line y equals x, where the absolute value of x is at least the absolute value of y."/>
              <annotation ref="hs3" text="Shape three, the circular sector between the line y equals x and the y axis, where the absolute value of y is at least the absolute value of x."/>
              <annotation ref="hs4" text="Shape four, the circular sector between the line y equals minus x and the negative x axis, where the absolute value of x is at least the absolute value of y."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw4o-density-shapes">
    <title>Which Shapes Can Carry This Density?</title>
    <statement>
      <p>
        With <m>\delta(x,y) = x^2-y^2</m> and the shapes of
        <xref ref="fig-hw4o-shapes"/>: type the numbers of the two shapes
        that can carry <m>\delta</m> as a density, in increasing order and
        separated by a comma (for instance <c>1,3</c>).
      </p>
      <p>Answer: <var width="8"/></p>
      <p>Which of those two is heavier? Type its number.</p>
      <p>Answer: <var width="6"/></p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="2\s*,\s*4">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string="1\s*,\s*3">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="2">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string="4">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw4-solutions">
      <p>
        A density cannot be negative, so we need
        <m>x^2 - y^2 \ge 0</m>, that is <m>|x| \ge |y|</m>. That holds on
        shapes <m>2</m> and <m>4</m>, and fails on shapes <m>1</m> and
        <m>3</m>.
      </p>
      <p>
        Shape <m>2</m> is the triangle of area <m>r^2/2</m> and shape
        <m>4</m> the sector of area <m>\pi r^2/8</m>. The triangle
        contains the sector's range of radii and has the larger area, so
        <m>\iint_{R_2}\delta\,dA \ge \iint_{R_4}\delta\,dA</m>: shape
        <m>2</m> is heavier.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw4o-reverse-order">
    <title>Reversing the Order of Integration</title>
    <statement>
      <p>
        Rewrite <m>\displaystyle\int_0^5\!\!\int_{x/2}^{x}
        f(x,y)\,dy\,dx</m> with the order of integration reversed.
      </p>
      <p>
        How many double integrals does the reversed order need?
        <var width="6"/>
      </p>
      <p>
        Taking them in order of increasing <m>y</m>: the first runs up to
        <m>y = </m> <var width="6"/>, and in it <m>x</m> goes from <m>y</m>
        to <var width="8"/>; in the second, <m>x</m> goes from <m>y</m> to
        <var width="6"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="1" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="2.5" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="2\s*\*?\s*y">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="5" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw4-solutions">
      <p>
        The region is bounded by <m>y = x/2</m> below, <m>y = x</m> above,
        and <m>x = 5</m> on the right. Reading it in <m>y</m>-slices, the
        left boundary is always <m>x = y</m>; the right boundary is
        <m>x = 2y</m> until <m>2y = 5</m>, and <m>x = 5</m> after that:
      </p>
      <me>
        \int_0^{5/2}\!\!\int_{y}^{2y} f\,dx\,dy
        + \int_{5/2}^{5}\!\!\int_{y}^{5} f\,dx\,dy .
      </me>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw4o-volume">
    <title>A Volume Over a Triangle</title>
    <statement>
      <p>
        Find the volume under <m>z = \sqrt{1-x^2}</m> and above the
        triangle formed by <m>y=x</m>, <m>x=1</m>, and the <m>x</m>-axis.
      </p>
      <p>
        After integrating in <m>y</m>, the remaining integrand is
        <var width="12"/> (in terms of <m>x</m>), and the volume is
        <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="x\s*\*?\s*sqrt\s*\(\s*1\s*-\s*x\s*\^\s*2\s*\)">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
                <condition string=".*">
            <feedback>
                  <p>Incorrect.</p>
                </feedback>
          </condition>
        </var>
      <var>
        <condition number="0.333" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw4-solutions">
      <p>
        The triangle is <m>0 \le x \le 1</m>, <m>0 \le y \le x</m>, so
      </p>
      <md>
        <mrow>
          V \amp = \int_0^1\!\!\int_0^x \sqrt{1-x^2}\,dy\,dx
          = \int_0^1 x\sqrt{1-x^2}\,dx
        </mrow>
        <mrow>
          \amp = \left[-\tfrac13\left(1-x^2\right)^{3/2}\right]_0^1
          = \frac13 .
        </mrow>
      </md>
    </solution>
  </exercise>
  </exercises>
</section>
