<polygon at="pxz-D" fill="#fbe3d0" stroke="none" closed="yes"
    points="((0,0),(1,0),(0.995,0.00997),(0.98,0.0396),(0.95,0.0975),(0.9,0.19),(0.85,0.2775),(0.8,0.36),(0.75,0.4375),(0.7,0.51),(0.65,0.5775),(0.6,0.64),(0.55,0.6975),(0.5,0.75),(0.45,0.7975),(0.4,0.84),(0.35,0.8775),(0.3,0.91),(0.25,0.9375),(0.2,0.96),(0.15,0.9775),(0.1,0.99),(0.05,0.9975),(0,1))"/>
<parametric-curve at="pxz-par" function="par" domain="(0,1)"
    stroke="#0072B2" thickness="3"/>
<label at="pxz-label" anchor="(0.68,0.72)" alignment="ne"
    color="#0072B2"><m>z = 1-x^2</m></label>
<point at="pxz-1" p="(1,0)" fill="black" alignment="s">
<m>1</m>
</point>
<point at="pxz-1z" p="(0,1)" fill="black" alignment="w">
<m>1</m>
</point>
</coordinates>
<annotations>
<annotation ref="figure" text="The x z projection: the region under the parabola z equals one minus x squared in the first quadrant.">
  <annotation ref="pxz-D" text="The projection into the x z plane, bounded above by the parabola."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
<image>
<prefigure xmlns="https://prefigure.org" label="prefigure-proj-yz">
<diagram dimensions="(210,200)" margins="10">
<definition>cur(t) = (t, 1 - (1-t)^2)</definition>
<coordinates bbox="(-0.3,-0.3,1.45,1.35)">
<axes at="pyz-axes" xlabel="y" ylabel="z" decorations="no" arrows="1"/>
<rectangle at="pyz-D" lower-left="(0,0)" dimensions="(1,1)"
    fill="#fbe3d0" stroke="#555555" thickness="1"/>
<parametric-curve at="pyz-cur" function="cur" domain="(0,1)"
    stroke="#0072B2" thickness="3"/>
<label at="pyz-R1" anchor="(0.62,0.3)" alignment="c">
<m>R_1</m>
</label>
<label at="pyz-R2" anchor="(0.28,0.82)" alignment="c">
<m>R_2</m>
</label>
<label at="pyz-label" anchor="(0.98,0.55)" alignment="se"
    color="#0072B2"><m>z = 1-(1-y)^2</m></label>
<point at="pyz-1" p="(1,0)" fill="black" alignment="s">
<m>1</m>
</point>
<point at="pyz-1z" p="(0,1)" fill="black" alignment="w">
<m>1</m>
</point>
</coordinates>
<annotations>
<annotation ref="figure" text="The y z projection: the unit square split by the curve z equals one minus the square of one minus y into a lower region R 1 and an upper region R 2.">
  <annotation ref="pyz-D" text="The unit square projection into the y z plane."/>
  <annotation ref="pyz-cur" text="The curve z equals one minus the square of one minus y, which separates R 1 from R 2 and forces the split into two integrals."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</sidebyside>
</figure>

</subsection>

<!-- ================================================================ -->
<subsection xml:id="sec-triple-mass">
<title>Mass With Variable Density</title>

<example xml:id="example-triple-mass">
<title>Example III</title>
<statement>
<p>
Assume that the density (mass per unit volume) is given by
<m>\rho(x,y,z) = x</m>. Evaluate the mass <m>M</m> of the solid
<m>R</m> of <xref ref="fig-triple-wedge-tikz"/>.
</p>
</statement>
</example>

<solution>
<p>
Using <m>M = \iiint_R \rho(x,y,z)\,dV</m> with the same limits as in
Part A of <xref ref="example-triple-order"/>:
</p>

<md>
<mrow>
M \amp= \int_{y=0}^{1}\!\!\int_{x=0}^{1-y}\!\!\int_{z=0}^{1-x^2}
x\,dz\,dx\,dy
= \int_0^1\!\!\int_0^{1-y} x\left(1 - x^2\right)dx\,dy
</mrow>
<mrow>
\amp= \int_0^1\left[\frac{x^2}{2}
- \frac{x^4}{4}\right]_{x=0}^{x=1-y} dy
= \int_0^1\left[\frac{(1-y)^2}{2}
- \frac{(1-y)^4}{4}\right]dy
</mrow>
<mrow>
\amp= \left[-\frac{(1-y)^3}{6}
+ \frac{(1-y)^5}{20}\right]_0^1
= \frac16 - \frac1{20} = \frac{7}{60}.
</mrow>
</md>
</solution>

</subsection>

</section>
