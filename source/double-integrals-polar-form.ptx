<circle at="sd-disk" center="(1,0)" radius="1" fill="#fbe3d0"
    stroke="none"/>
<parametric-curve at="sd-circle" function="circ" domain="(0,2*pi)"
    stroke="#D55E00" thickness="3"/>
<point at="sd-1" p="(1,0)" fill="black" alignment="s">
<m>1</m>
</point>
<point at="sd-2" p="(2,0)" fill="black" alignment="se">
