</label>
</coordinates>
<annotations>
<annotation ref="figure" text="A disk of radius one centered at the point one comma zero, shaded tan and labeled D. Its boundary circle, drawn in vermillion, passes through the origin and through the point two comma zero, and is the polar curve r equals two cosine theta.">
  <annotation ref="sd-disk" text="The base disk D, of radius one centered at one comma zero."/>
