<!-- ================================================================ -->
<subsection xml:id="sec-polar-annulus-example">
<title>Integrating Over a Half Annulus</title>

<example xml:id="example-polar-annulus">
<title>Example I</title>
<statement>
<p>
Evaluate <m>\displaystyle\iint_R (3x + 4y^2)\,dA</m>, where <m>R</m>
is the region in the upper half plane bounded by the circles
<m>x^2 + y^2 = 1</m> and <m>x^2 + y^2 = 4</m>.
</p>
</statement>
</example>

<solution>
<p>
The region
</p>

<me>
R = \{(x,y) \mid y \ge 0,\ 1 \le x^2 + y^2 \le 4\}
</me>

<p>
is shown in <xref ref="fig-half-annulus-prefigure"/>, and in polar
coordinates we have
</p>

<me>
R = \{(r,\theta) : 1 \le r \le 2,\ 0 \le \theta \le \pi\}.
</me>

<p>
Therefore, using <m>x = r\cos\theta</m> and <m>y = r\sin\theta</m>, we
can write:
</p>

<md>
<mrow>
\iint_R (3x + 4y^2)\,dA
\amp= \int_0^{\pi}\!\!\int_1^2
\left(3r\cos\theta + 4r^2\sin^2\theta\right) r\,dr\,d\theta
</mrow>
<mrow>
\amp= \int_0^{\pi}\!\!\int_1^2
\left(3r^2\cos\theta + 4r^3\sin^2\theta\right) dr\,d\theta
</mrow>
<mrow>
\amp= \int_0^{\pi}
\Big[r^3\cos\theta + r^4\sin^2\theta\Big]_{r=1}^{r=2}\,d\theta
= \int_0^{\pi}\left(7\cos\theta + 15\sin^2\theta\right)d\theta
</mrow>
<mrow>
\amp= \int_0^{\pi}\left[7\cos\theta
+ \tfrac{15}{2}\left(1 - \cos 2\theta\right)\right]d\theta
</mrow>
<mrow>
\amp= \left.\left(7\sin\theta + \frac{15\theta}{2}
- \frac{15}{4}\sin 2\theta\right)\right|_0^{\pi}
= \frac{15\pi}{2}.
</mrow>
</md>
</solution>

<figure xml:id="fig-half-annulus-prefigure">
<caption>
The region of <xref ref="example-polar-annulus"/>: the upper half of
the annulus between the circles <m>x^2+y^2 = 1</m> and
<m>x^2+y^2 = 4</m>. In polar coordinates it is simply
<m>1 \le r \le 2</m>, <m>0 \le \theta \le \pi</m>.
</caption>
<image width="60%">
<prefigure xmlns="https://prefigure.org" label="prefigure-half-annulus">
<diagram dimensions="(380,232)" margins="10">
<definition>outer(t) = (2*cos(t), 2*sin(t))</definition>
<definition>inner(t) = (cos(t), sin(t))</definition>
<coordinates bbox="(-2.6,-0.5,2.6,2.5)">
<axes at="ha-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<polygon at="ha-region" fill="#fbe3d0" stroke="none" closed="yes"
    points="((1,0),(2,0),(1.9754,0.3129),(1.9021,0.618),(1.782,0.908),(1.6180,1.1756),(1.4142,1.4142),(1.1756,1.618),(0.908,1.782),(0.618,1.9021),(0.3129,1.9754),(0,2),(-0.3129,1.9754),(-0.618,1.9021),(-0.908,1.782),(-1.1756,1.618),(-1.4142,1.4142),(-1.618,1.1756),(-1.782,0.908),(-1.9021,0.618),(-1.9754,0.3129),(-2,0),(-1,0),(-0.9877,0.1564),(-0.9511,0.309),(-0.891,0.454),(-0.809,0.5878),(-0.7071,0.7071),(-0.5878,0.809),(-0.454,0.891),(-0.309,0.9511),(-0.1564,0.9877),(0,1),(0.1564,0.9877),(0.309,0.9511),(0.454,0.891),(0.5878,0.809),(0.7071,0.7071),(0.809,0.5878),(0.891,0.454),(0.9511,0.309),(0.9877,0.1564))"/>
<parametric-curve at="ha-outer" function="outer" domain="(0,pi)"
    stroke="#0072B2" thickness="3"/>
<parametric-curve at="ha-inner" function="inner" domain="(0,pi)"
    stroke="#D55E00" thickness="3"/>
<label at="ha-R" anchor="(0,1.5)" alignment="c">
