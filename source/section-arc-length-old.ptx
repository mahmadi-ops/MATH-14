<?xml version="1.0" encoding="UTF-8"?>
<!-- Complementary Modules for MATH 14 -->
<!-- Section: Arc Length of a Curve                                        -->
<!--                                                                       -->
<!-- Media wiring (relative to the PreTeXt source root):                   -->
<!--   Manim videos    : videos/*_1080p.mp4                       -->
<!--   PreFigure        : embedded inline inside <image><prefigure> ...     -->
<!--   GeoGebra applets : referenced by material id (see notes below)      -->
<!--                                                                       -->
<!-- GeoGebra material ids are placeholders. Publish each construction     -->
<!-- (assets/geogebra/*.commands.txt or *.ggb) to geogebra.org and replace -->
<!-- the geogebra="..." values below with the real ids.                    -->

<section xml:id="sec-arc-length">
  <title>Arc Length of a Curve</title>

  <introduction>
    <p>
      When an object moves along a curve, we often want to know the total
      distance it travels. In this section we build the arc-length integral
      first in the plane and then in space, and we apply it to two motions:
      a point sweeping out a quarter circle and a paraglider spiralling to
      the ground.
    </p>
  </introduction>

  <!-- ================================================================= -->
  <subsection xml:id="subsec-arc-length-2d">
    <title>Arc Length in 2D</title>

    <p>
      Imagine that at time <m>t=a</m> an object starts moving from an initial
      point <m>A</m> and at time <m>t=b</m> it reaches the final point
      <m>B</m>. During this period the object traces out a smooth curve
      <m>C</m> on a plane, as shown in <xref ref="fig-arc-length-curve"/>.
      How can we calculate the distance that the object has travelled?
    </p>

    <figure xml:id="fig-arc-length-curve">
      <caption>
        A smooth curve <m>C</m> traced by a moving object, from the starting
        point <m>A</m> at time <m>t=a</m> to the ending point <m>B</m> at
        time <m>t=b</m>.
      </caption>
      <image xml:id="image-arc-length-curve" width="55%">
        <description>
          A curve labelled C rises from a red point marked t equals a at the
          lower right to a red point marked t equals b at the upper left, with
          an arrow indicating the direction of increasing time.
        </description>
        <prefigure label="arc-length-curve" xmlns="https://prefigure.org">
          <diagram dimensions="(400,400)" margins="5">
            <definition>C(t)=(3*cos(t), 3*sin(t))</definition>
            <definition>A=C(0.42)</definition>
            <definition>B=C(1.52)</definition>

            <coordinates bbox="[-0.5,-0.5,3.6,3.6]">
              <group at="curve-C">
                <parametric-curve function="C" domain="(0.42,1.52)" stroke="blue"
                                  thickness="3" arrows="1" arrow-location="1.0"/>
                <label anchor="C(1.05)" alignment="ne" offset="(12,12)">
                  <m>C</m>
                </label>
              </group>

              <group at="point-A">
                <point p="A" size="4" stroke="red" fill="red"/>
                <label anchor="A" alignment="se" offset="(6,-4)" clear-background="yes">
                  <m>t=a</m>
                </label>
              </group>

              <group at="point-B">
                <point p="B" size="4" stroke="red" fill="red"/>
                <label anchor="B" alignment="nw" offset="(-6,4)" clear-background="yes">
                  <m>t=b</m>
                </label>
              </group>
            </coordinates>

            <annotations>
              <annotation ref="figure"
                          text="A smooth curve C traced by a moving object from the starting point A at time t equals a to the ending point B at time t equals b">
                <annotation ref="curve-C"
                            text="The curve C, traversed in the direction of increasing time from A to B"
                            sonify="yes"/>
                <annotation ref="point-A" text="The starting point A, reached at time t equals a"/>
                <annotation ref="point-B" text="The ending point B, reached at time t equals b"/>
              </annotation>
            </annotations>
          </diagram>
        </prefigure>
      </image>
    </figure>

    <p>
      The length of an infinitesimal arc in 2D is
      <m>ds=\sqrt{dx^2+dy^2}</m>, hence to find the full length of the curve
      we integrate from point <m>A</m> to point <m>B</m>:
    </p>

    <me>
      \int_A^B ds = \int_A^B \sqrt{dx^2+dy^2}.
    </me>

    <p>
      Now assume that the curve <m>C</m> can be parametrized as
      <m>(x(t),y(t))</m>, or equivalently in the vector form
      <m>\mathbf{r}(t)=x(t)\,\mathbf{i}+y(t)\,\mathbf{j}</m>. Then we can
      rewrite the formula above as
    </p>

    <me>
      \int_A^B ds
        = \int_a^b \sqrt{\left(\frac{dx}{dt}\right)^2
                       + \left(\frac{dy}{dt}\right)^2}\,dt
        = \int_a^b \left|\mathbf{v}(t)\right|\,dt,
    </me>

    <p>
      where we have used the fact that the velocity vector is
    </p>

    <me>
      \mathbf{v}(t)=\frac{d\mathbf{r}(t)}{dt}
        =\left(\frac{dx(t)}{dt},\frac{dy(t)}{dt}\right),
    </me>

    <p>
      and therefore
    </p>

    <me>
      \left|\mathbf{v}(t)\right|
        =\sqrt{\left(\frac{dx}{dt}\right)^2
             + \left(\frac{dy}{dt}\right)^2}.
    </me>
  </subsection>

  <!-- ================================================================= -->
  <!-- EXAMPLE 1: quarter circle. Statement only; solution is a separate  -->
  <!-- <solution> environment placed after the <statement>.               -->
  <example xml:id="ex-quarter-circle">
    <title>Length of a quarter circle</title>
    <statement>
      <p>
        Using the formulas for arc length in 2D, calculate the length of a
        quarter circle of radius one. Note that we already know the answer to
        this question is <m>\dfrac{\pi}{2}</m>.
      </p>
    </statement>

    <solution>
      <p>
        We can parametrize such a curve as
        <me>\mathbf{r}(t)=(\cos t,\sin t),\qquad 0\le t\le\frac{\pi}{2}.</me>
        Differentiating, the velocity vector and its length are
      </p>
      <md>
        <mrow>\mathbf{v}(t) \amp = (-\sin t,\ \cos t),</mrow>
        <mrow>\left|\mathbf{v}(t)\right| \amp
              = \sqrt{\sin^2 t+\cos^2 t}=1.</mrow>
      </md>
      <p>
        Because the speed is constant and equal to <m>1</m>, the arc length is
      </p>
      <me>
        \int_C ds = \int_0^{\pi/2}\left|\mathbf{v}(t)\right|\,dt
                  = \int_0^{\pi/2} 1\,dt = \frac{\pi}{2},
      </me>
      <p>
        which agrees with the known circumference of a quarter circle of
        radius one. The motion, the position vector <m>\mathbf{r}(t)</m>, and
        the unit velocity vector <m>\mathbf{v}(t)</m> are shown in
        <xref ref="fig-quarter-circle-video"/> and
        <xref ref="fig-quarter-circle-prefigure"/>, and you can explore the
        construction yourself in <xref ref="fig-quarter-circle-geogebra"/>.
      </p>

      <figure xml:id="fig-quarter-circle-video">
        <caption>
          The point <m>\mathbf{r}(t)=(\cos t,\sin t)</m> sweeps out the
          quarter circle as <m>t</m> increases from <m>0</m> to
          <m>\pi/2</m>; the accumulated arc length <m>s(t)=t</m> reaches
          <m>\pi/2\approx 1.5708</m>.
        </caption>
        <video xml:id="video-quarter-circle" width="80%"
               source="videos/quarter_circle_arclength_1080p.mp4"/>
      </figure>

      <figure xml:id="fig-quarter-circle-prefigure">
        <caption>
          The quarter circle <m>\mathbf{r}(t)=(\cos t,\sin t)</m> with the
          position vector (orange) and the unit velocity vector
          <m>\mathbf{v}(t)</m> (green), which is tangent to the curve.
        </caption>
        <image xml:id="image-quarter-circle-arclength" width="60%">
          <description>
            A quarter of the unit circle from the point one comma zero to the
            point zero comma one on a coordinate grid, with an orange position
            vector from the origin to a point on the arc and a green unit
            velocity vector tangent to the arc at that point.
          </description>
          <prefigure label="quarter-circle-arclength" xmlns="https://prefigure.org">
            <diagram dimensions="(400,400)" margins="5">
              <definition>r(t)=(cos(t), sin(t))</definition>
              <definition>t0=0.9</definition>
              <definition>P=r(t0)</definition>
              <definition>vel=(-sin(t0), cos(t0))</definition>

              <coordinates bbox="[-0.35,-0.35,1.5,1.5]">
                <grid-axes xlabel="x" ylabel="y" spacing="(0.5,0.5)"/>

                <group at="arc">
                  <parametric-curve function="r" domain="(0,pi/2)" stroke="blue"
                                    thickness="3" arrows="1" arrow-location="1.35"/>
                  <label anchor="r(0.5)" alignment="ne" offset="(12,10)" clear-background="yes">
                    <m>\mathbf{r}(t)</m>
                  </label>
                </group>

                <group at="endpoints">
                  <point p="(1,0)" size="4" stroke="black" fill="black"/>
                  <label anchor="(1,0)" alignment="ne" offset="(4,4)" clear-background="yes">
                    <m>(1,0)</m>
                  </label>
                  <point p="(0,1)" size="4" stroke="black" fill="black"/>
                  <label anchor="(0,1)" alignment="ne" offset="(6,4)" clear-background="yes">
                    <m>(0,1)</m>
                  </label>
                </group>

                <group at="radius">
                  <vector v="P" tail="(0,0)" stroke="orange"/>
                  <point p="P" size="3.5" stroke="red" fill="red"/>
                </group>

                <group at="velocity">
                  <vector v="vel" tail="P" stroke="green"/>
                  <label anchor="P+0.5*vel" alignment="nw" offset="(-6,6)" clear-background="yes">
                    <m>\mathbf{v}(t)</m>
                  </label>
                </group>
              </coordinates>

              <annotations>
                <annotation ref="figure"
                            text="A quarter of the unit circle parametrized by r of t equals cosine t, sine t, for t between 0 and pi over 2, showing the position and unit velocity vectors">
                  <annotation ref="grid" text="The coordinate grid"/>
                  <annotation ref="axes" text="The coordinate axes"/>
                  <annotation ref="arc"
                              text="The quarter circle arc from the point 1 comma 0 to the point 0 comma 1"
                              sonify="yes"/>
                  <annotation ref="endpoints" text="The endpoints 1 comma 0 and 0 comma 1"/>
                  <annotation ref="radius" text="The position vector r of t from the origin to a point on the arc"/>
                  <annotation ref="velocity"
                              text="The velocity vector v of t, tangent to the arc, which has length one"/>
                </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>

      <figure xml:id="fig-quarter-circle-geogebra">
        <caption>
          Interactive quarter circle: drag the slider <m>t</m> to move the
          point along the arc and watch the position and velocity vectors and
          the running arc length <m>s(t)=t</m>.
        </caption>
        <interactive xml:id="ggb-quarter-circle" platform="geogebra"
                     width="60%" aspect="1:1">
          <slate xml:id="ggb-quarter-circle-slate" surface="geogebra"
                 aspect="1:1">setAxesVisible(true, true);
setGridVisible(true);
setCoordSystem(-0.4, 1.6, -0.4, 1.6);
evalCommand('t=Slider(0,pi/2,0.01)');
setValue('t',0.9);
evalCommand('full=Curve(cos(s),sin(s),s,0,pi/2)');
setColor('full',160,160,160);
evalCommand('arc=Curve(cos(s),sin(s),s,0,t)');
setColor('arc',0,102,204);
setLineThickness('arc',6);
evalCommand('P=(cos(t),sin(t))');
setColor('P',204,0,0);
setPointSize('P',5);
evalCommand('rvec=Vector((0,0),P)');
setColor('rvec',255,153,0);
evalCommand('vvec=Vector(P,P+(-sin(t),cos(t)))');
setColor('vvec',0,153,0);
evalCommand('A=(1,0)');
evalCommand('B=(0,1)');
evalCommand('s=t');
evalCommand('sLen=Text("arc length s(t) = "+(Round(s,3)),(-0.35,1.55))');</slate>
        </interactive>
      </figure>
    </solution>
  </example>

  <!-- ================================================================= -->
  <subsection xml:id="subsec-arc-length-3d">
    <title>Arc Length in 3D</title>

    <p>
      The formulas above are easily generalized to motion in space. For a
      space curve <m>\mathbf{r}(t)=\bigl(x(t),y(t),z(t)\bigr)</m> we have
    </p>

    <md>
      <mrow>
        \int_A^B ds \amp
          = \int_a^b \sqrt{\left(\frac{dx}{dt}\right)^2
                         + \left(\frac{dy}{dt}\right)^2
                         + \left(\frac{dz}{dt}\right)^2}\,dt
          = \int_a^b \left|\mathbf{v}(t)\right|\,dt,
      </mrow>
      <mrow>
        \mathbf{v}(t) \amp
          = \frac{d\mathbf{r}(t)}{dt}
          = \left(\frac{dx(t)}{dt},\frac{dy(t)}{dt},\frac{dz(t)}{dt}\right),
      </mrow>
      <mrow>
        \left|\mathbf{v}(t)\right| \amp
          = \sqrt{\left(\frac{dx}{dt}\right)^2
                + \left(\frac{dy}{dt}\right)^2
                + \left(\frac{dz}{dt}\right)^2}.
      </mrow>
    </md>
  </subsection>

  <!-- ================================================================= -->
  <!-- EXAMPLE 2: paraglider. Statement (parts A,B,C); solution separate. -->
  <example xml:id="ex-paraglider">
    <title>Distance travelled by a paraglider</title>
    <statement>
      <p>
        The position of a paraglider at time <m>t</m> is
        <me>
          \mathbf{r}(t)=\left(t\cos t,\ t\sin t,\
            9\sqrt{8}-\frac{\sqrt{8}}{3}\,t^{3/2}\right).
        </me>
        Assuming that the paraglider begins at time <m>t=0</m>:
      </p>
      <ol>
        <li>
          <p>
            How long does it take to reach the ground, that is,
            <m>z=0</m>?
          </p>
        </li>
        <li>
          <p>
            Calculate the velocity vector at time <m>t</m>, and also
            calculate its length.
          </p>
        </li>
        <li>
          <p>Calculate the distance travelled by the paraglider.</p>
        </li>
      </ol>
    </statement>

    <solution>
      <p>
        <term>Part A.</term> Since the ground is at <m>z=0</m>, we solve
        <me>9\sqrt{8}-\frac{\sqrt{8}}{3}\,t^{3/2}=0
            \quad\Longrightarrow\quad t^{3/2}=27
            \quad\Longrightarrow\quad t=9,</me>
        so it takes <m>9</m> units of time for the paraglider to reach the
        ground.
      </p>

      <p>
        <term>Part B.</term> Differentiating each component,
      </p>
      <me>
        \mathbf{v}(t)=\frac{d\mathbf{r}(t)}{dt}
          =\Bigl(\cos t-t\sin t,\ \sin t+t\cos t,\ -\sqrt{2}\,t^{1/2}\Bigr).
      </me>
      <p>
        Its length simplifies neatly:
      </p>
      <md>
        <mrow>
          \left|\mathbf{v}(t)\right| \amp
            = \sqrt{(\cos t-t\sin t)^2+(\sin t+t\cos t)^2+2t}
        </mrow>
        <mrow>
          \amp = \sqrt{\cos^2 t+t^2\sin^2 t-2t\sin t\cos t
                     + \sin^2 t+t^2\cos^2 t+2t\sin t\cos t+2t}
        </mrow>
        <mrow>
          \amp = \sqrt{t^2+2t+1}=t+1.
        </mrow>
      </md>

      <p>
        <term>Part C.</term> The distance travelled equals the total arc
        length,
      </p>
      <me>
        s=\int_0^{9}\left|\mathbf{v}(t)\right|\,dt
         =\int_0^{9}(t+1)\,dt
         =\left[\frac{t^2}{2}+t\right]_0^{9}
         =\frac{81}{2}+9=49.5.
      </me>
      <p>
        The descending spiral, together with its endpoints
        <m>\langle 0,0,9\sqrt{8}\rangle</m> and
        <m>\langle 9\cos 9,\,9\sin 9,\,0\rangle</m>, is shown in
        <xref ref="fig-paraglider-video"/>, and you can rotate and explore it
        in <xref ref="fig-paraglider-geogebra"/>.
      </p>

      <figure xml:id="fig-paraglider-video">
        <caption>
          The paraglider spirals down from
          <m>\langle 0,0,9\sqrt{8}\rangle</m> to
          <m>\langle 9\cos 9,\,9\sin 9,\,0\rangle</m>. Because the speed is
          <m>\left|\mathbf{v}(t)\right|=t+1</m>, the total distance travelled
          is <m>s=49.5</m>.
        </caption>
        <video xml:id="video-paraglider" width="85%"
               source="videos/paraglider_arclength_1080p.mp4"/>
      </figure>

      <figure xml:id="fig-paraglider-geogebra">
        <caption>
          Interactive 3D spiral: drag the slider <m>t</m> to fly the
          paraglider along its path and watch the distance travelled
          <m>s(t)=\tfrac{t^2}{2}+t</m> increase.
        </caption>
        <interactive xml:id="ggb-paraglider" platform="geogebra"
                     width="70%" aspect="4:3">
          <slate xml:id="ggb-paraglider-slate" surface="geogebra"
                 aspect="4:3" perspective="T">evalCommand('t=Slider(0,9,0.01)');
setValue('t',4.5);
evalCommand('path=Curve(u*cos(u),u*sin(u),9*sqrt(8)-sqrt(8)/3*u^(3/2),u,0,9)');
setColor('path',0,102,204);
setLineThickness('path',5);
evalCommand('P=(t*cos(t),t*sin(t),9*sqrt(8)-sqrt(8)/3*t^(3/2))');
setColor('P',255,102,0);
setPointSize('P',6);
evalCommand('A=(0,0,9*sqrt(8))');
setColor('A',204,0,0);
setPointSize('A',5);
evalCommand('B=(9*cos(9),9*sin(9),0)');
setColor('B',204,0,0);
setPointSize('B',5);
evalCommand('s=t^2/2+t');</slate>
        </interactive>
      </figure>
    </solution>
  </example>

</section>
